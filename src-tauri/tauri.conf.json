{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlashGet",
  "version": "2.1.0",
  "mainBinaryName": "FlashGet",
  "identifier": "com.jstephane98.flashget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlashGet",
        "decorations": false,
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDM0VGMUQ1RDBGNjFGNjgKUldSb0gvYlExZkUrekpxUzZEQUZ0VVdmVHZ5ekU0Q1RPVHg4N3pYSzVBOVlsdnQxclVKWnRPUFQK",
      "endpoints": ["https://github.com/jstephane98/FlashGet/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "French"],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../extension/manifest.json": "extension/manifest.json",
      "../extension/background.js": "extension/background.js",
      "../extension/buildCapture.js": "extension/buildCapture.js",
      "../extension/capture-rules.js": "extension/capture-rules.js",
      "../extension/media-rules.js": "extension/media-rules.js",
      "../extension/stream-store.js": "extension/stream-store.js",
      "../extension/site-rules.js": "extension/site-rules.js",
      "../extension/browser-info.js": "extension/browser-info.js",
      "../extension/popup.js": "extension/popup.js",
      "../extension/popup-state.js": "extension/popup-state.js",
      "../extension/options.js": "extension/options.js",
      "../extension/i18n.js": "extension/i18n.js",
      "../extension/_locales/en/messages.json": "extension/_locales/en/messages.json",
      "../extension/_locales/fr/messages.json": "extension/_locales/fr/messages.json",
      "../extension/popup.html": "extension/popup.html",
      "../extension/options.html": "extension/options.html",
      "../extension/ui.css": "extension/ui.css",
      "../extension/icons/16.png": "extension/icons/16.png",
      "../extension/icons/32.png": "extension/icons/32.png",
      "../extension/icons/48.png": "extension/icons/48.png",
      "../extension/icons/128.png": "extension/icons/128.png",
      "../extension/fonts/archivo-500.woff2": "extension/fonts/archivo-500.woff2",
      "../extension/fonts/archivo-700.woff2": "extension/fonts/archivo-700.woff2",
      "../extension/fonts/archivo-800.woff2": "extension/fonts/archivo-800.woff2",
      "../extension/fonts/jetbrains-mono-500.woff2": "extension/fonts/jetbrains-mono-500.woff2",
      "../extension/fonts/jetbrains-mono-700.woff2": "extension/fonts/jetbrains-mono-700.woff2"
    },
    "externalBin": ["bin/ffmpeg", "bin/yt-dlp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
