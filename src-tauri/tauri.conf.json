{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlashGet",
  "version": "2.0.0",
  "mainBinaryName": "FlashGet",
  "identifier": "com.jstephane98.flashget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlashGet",
        "decorations": false,
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REMPLACER_PAR_LA_CLE_PUBLIQUE",
      "endpoints": ["https://github.com/jstephane98/FlashGet/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    },
    "externalBin": ["bin/ffmpeg", "bin/yt-dlp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
