{
  "manifest_version": 3,
  "name": "FlashGet — Capture",
  "version": "0.1.0",
  "description": "Envoie les téléchargements à l'application FlashGet (capture automatique et manuelle).",
  "permissions": ["contextMenus", "storage", "activeTab", "alarms", "cookies", "downloads", "webRequest"],
  "host_permissions": ["ws://127.0.0.1/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlashGet",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "options_page": "options.html"
}
